# Base de donnees (SQLite par defaut, fonctionne "out of the box")
# Pour passer sur PostgreSQL, changer le "provider" dans prisma/schema.prisma
# et utiliser une URL du type postgresql://user:password@host:5432/dbname
DATABASE_URL="file:./dev.db"

# Secret utilise pour signer les tokens JWT (change cette valeur en production !)
JWT_SECRET="change-moi-en-une-longue-chaine-aleatoire"

# Duree de validite du token, format zeit/ms (ex: "30d", "12h")
JWT_EXPIRES_IN="30d"

# Port d'ecoute de l'API
PORT=4000

# Origine autorisee pour le CORS (URL du frontend)
FRONTEND_URL="http://localhost:5173"

# Cles VAPID pour les notifications push (genere-les avec `npm run vapid:generate`)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@example.com"

# Heure (0-23, heure serveur) a laquelle envoyer le rappel quotidien
REMINDER_HOUR=18
