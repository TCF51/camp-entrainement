// Schema Prisma - Application de suivi de camps d'entrainement
// Par defaut : SQLite (aucune installation requise).
// Pour passer sur PostgreSQL en production, remplacer le provider ci-dessous
// par "postgresql" et adapter DATABASE_URL dans .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Note : pas d'enum Prisma ici (ExerciseUnit / RecurrenceType) car SQLite ne supporte pas
// les enums natifs. Les valeurs autorisees ("REPS"/"SECONDS", "DAILY"/"WEEKLY"/"EVERY_N_DAYS")
// sont validees cote API avec zod.

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String
  weightKg       Float?
  heightCm       Float?
  birthDate      DateTime?
  sex            String?  // "F" | "M" | "AUTRE" | null, libre / optionnel
  sport          String?  // pratique principale, libre choix dans une liste cote frontend
  sportLevel     String?  // "LOISIR" | "COMPETITION" | null
  avatarBase64   String?  // photo de profil encodee en data URL (redimensionnee cote client)
  createdAt      DateTime @default(now())

  memberships    CampMembership[]
  createdCamps   Camp[]            @relation("CampCreator")
  createdExos    Exercise[]        @relation("ExerciseCreator")
  logs           ExerciseLog[]
  subscriptions  PushSubscription[]
  badges         UserBadge[]
  campMessages   CampMessage[]
  sentMessages   DirectMessage[]   @relation("MessageSender")
  receivedMessages DirectMessage[] @relation("MessageRecipient")
  chronoSessions ChronoSession[]
  circuitLogs    CampCircuitLog[]
  restDays       RestDay[]
  favoriteCircuits FavoriteCircuit[]
  reactions      Reaction[]
  resetTokens    PasswordResetToken[]
}

model Exercise {
  id          String       @id @default(cuid())
  name        String
  description String?
  unit        String       // "REPS" ou "SECONDS"
  isCustom    Boolean      @default(false)
  createdById String?
  createdBy   User?        @relation("ExerciseCreator", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())

  campExercises CampExercise[]
  logs          ExerciseLog[]
}

model Camp {
  id          String    @id @default(cuid())
  name        String
  description String?
  code        String    @unique
  createdById String
  createdBy   User      @relation("CampCreator", fields: [createdById], references: [id])
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())

  exercises CampExercise[]
  circuits  CampCircuit[]
  members   CampMembership[]
  logs      ExerciseLog[]
  circuitLogs CampCircuitLog[]
  messages  CampMessage[]
}

// Consigne d'un exercice au sein d'un camp : definie UNIQUEMENT par le createur du camp
// (la "casquette entraineur"). Tous les membres suivent la meme consigne.
model CampExercise {
  id             String   @id @default(cuid())
  campId         String
  exerciseId     String
  description    String?  // court descriptif/consigne redige par le createur du camp
  targetSets     Int      @default(3)
  targetMode     String   @default("FIXED") // "FIXED" (objectif chiffre) ou "MAX" (a fond, sans cible fixe)
  targetValue    Int?     // nombre de repetitions OU de secondes vise (voir Exercise.unit) ; inutilise si targetMode = MAX
  recurrenceType String   @default("DAILY") // "DAILY" | "WEEKLY" | "EVERY_N_DAYS"
  daysOfWeek     String?  // JSON array ex: "[1,3,5]" (0=dimanche ... 6=samedi), utilise si WEEKLY
  intervalDays   Int?     // utilise si EVERY_N_DAYS
  startDate      DateTime @default(now())

  camp     Camp     @relation(fields: [campId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id])
  logs     ExerciseLog[]

  @@unique([campId, exerciseId])
}

model CampMembership {
  id       String   @id @default(cuid())
  userId   String
  campId   String
  joinedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  camp     Camp     @relation(fields: [campId], references: [id], onDelete: Cascade)

  @@unique([userId, campId])
}

model ExerciseLog {
  id         String   @id @default(cuid())
  userId     String
  campId     String
  exerciseId String
  date       DateTime // jour concerne (heure normalisee a minuit)
  setsDone   Int
  valueDone  Int      // repetitions ou secondes realisees (moyenne/estimation par serie, cf notes)
  completed  Boolean  @default(true)
  createdAt  DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  camp         Camp          @relation(fields: [campId], references: [id], onDelete: Cascade)
  exercise     Exercise      @relation(fields: [exerciseId], references: [id])
  campExercise CampExercise? @relation(fields: [campId, exerciseId], references: [campId, exerciseId])

  @@unique([userId, campId, exerciseId, date])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeKey  String   // identifiant du badge, voir src/utils/badges.ts pour le catalogue
  earnedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeKey])
}

// Discussion de groupe entre les membres d'un camp
model CampMessage {
  id        String   @id @default(cuid())
  campId    String
  userId    String
  body      String
  createdAt DateTime @default(now())

  camp Camp @relation(fields: [campId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Message prive entre deux utilisateurs (reserve aux personnes qui partagent au moins un camp)
model DirectMessage {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  body        String
  createdAt   DateTime @default(now())

  sender    User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
}

// Seance de circuit training "libre" (construite depuis l'onglet Chrono, pas liee a un camp).
// Enregistree une fois terminee, pour alimenter l'historique d'activite de l'utilisateur.
model ChronoSession {
  id                   String   @id @default(cuid())
  userId               String
  name                 String? // nom optionnel donne par l'utilisateur
  items                String  // JSON : liste ordonnee des noms d'exercices du circuit
  workSeconds          Int
  restSeconds          Int
  rounds               Int
  roundRestSeconds     Int
  totalDurationSeconds Int
  completedAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Circuit training defini par le createur d'un camp (alternative aux exercices individuels).
// Compose d'une liste ordonnee d'exercices avec temps de travail/repos, nombre de tours, etc.
model CampCircuit {
  id               String   @id @default(cuid())
  campId           String
  name             String
  description      String?
  items            String   // JSON : [{ "exerciseId": "...", "name": "..." }, ...] ordonne
  workSeconds      Int
  restSeconds      Int
  rounds           Int
  roundRestSeconds Int
  recurrenceType   String   @default("DAILY")
  daysOfWeek       String?
  intervalDays     Int?
  startDate        DateTime @default(now())

  camp Camp             @relation(fields: [campId], references: [id], onDelete: Cascade)
  logs CampCircuitLog[]
}

// Validation, par un membre, d'un circuit de camp realise un jour donne
model CampCircuitLog {
  id              String   @id @default(cuid())
  userId          String
  campCircuitId   String
  campId          String
  date            DateTime
  durationSeconds Int
  completed       Boolean  @default(true)
  createdAt       DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  campCircuit CampCircuit @relation(fields: [campCircuitId], references: [id], onDelete: Cascade)
  camp        Camp        @relation(fields: [campId], references: [id], onDelete: Cascade)

  @@unique([userId, campCircuitId, date])
}

// Jour marque comme "repos justifie" par l'utilisateur (blessure, voyage...) : ce jour
// n'est jamais compte comme un manque dans les calculs de regularite/streak, ni comme du
// depend  (il est neutre). S'applique globalement, tous camps/exercices confondus.
model RestDay {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime // jour concerne (heure normalisee a minuit)
  reason    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// Circuit training "favori" enregistre par un utilisateur depuis l'onglet Chrono,
// pour le relancer directement sans le reconstruire.
model FavoriteCircuit {
  id               String   @id @default(cuid())
  userId           String
  name             String
  items            String   // JSON : liste ordonnee des noms d'exercices
  workSeconds      Int
  restSeconds      Int
  rounds           Int
  roundRestSeconds Int
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Reaction rapide (encouragement) laissee par un membre de camp sur une seance validee
// par un autre membre (exercice ou circuit). Purement social, aucun impact sur les stats.
model Reaction {
  id         String   @id @default(cuid())
  userId     String   // qui reagit
  targetType String   // "exercise" ou "circuit" (type de log cible)
  targetId   String   // id du ExerciseLog ou CampCircuitLog cible
  type       String   // cle du type de reaction, voir src/utils/reactions.ts
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId, type])
}

// Jeton de reinitialisation de mot de passe, a duree de vie limitee
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
